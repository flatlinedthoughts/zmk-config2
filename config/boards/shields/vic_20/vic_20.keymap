#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer { // Layer 0
            // -------------------------------------
            // |     Z     |     M     |     K     |
            // |     A     |     B     |     C     |
            // |     D     |     E     |     F     |
            bindings = <
                &kp F13    &kp F14    &kp F19
                &kp F20    &kp F15    &kp F16
                &kp F17    &kp F21    &kp F18
            >;
        };
    };
 };
